# Copie para .env (fica fora do git) e preencha.
PORT=3100

# App criado em https://developers.mercadolivre.com.br/devcenter (Criar aplicação).
# Usado só aqui no backend, para pegar o token de aplicativo (client_credentials).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Admin único do backoffice. Sem estes, vale o admin do modo demo.
VITRINE_ADMIN_USER=admin
VITRINE_ADMIN_PASSWORD=

# Origens que podem chamar a API (host do portfólio e a vitrine sozinha).
VITRINE_CORS_ORIGINS=http://localhost:5180,http://localhost:5187
