# Sem estas variáveis o PayOps usa um mock em memória (mesmo contrato da API).
# Para usar o payops-agent real (docker compose), copie para .env.local:
VITE_PAYOPS_API_URL=http://127.0.0.1:3000
VITE_PAYOPS_AGENT_KEY=compose-agent-key-change-me
VITE_PAYOPS_APPROVER_KEY=compose-approver-secret-change-me
VITE_JAEGER_URL=http://127.0.0.1:16686
